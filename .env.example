# LLM provider: openai | ollama
LLM_PROVIDER=openai

# OpenAI (gpt-4.1-mini for fuzzy matching / reconciliation)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# Ollama — Llama 3.1 8B FP16 local
# Prerequisite: ollama serve && ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Apply agent matches at/above this confidence (else flag for human review)
AGENT_MATCH_MIN_CONF=0.55

# Set to 0 to skip live agent calls (deterministic id_map only) — useful offline
AGENT_ENABLED=1
